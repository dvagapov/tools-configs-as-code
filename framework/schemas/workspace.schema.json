{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "workspace", "frameworkRef", "repos"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "workspace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "frameworkRef": {"type": "string"},
    "wiki": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"directPush": {"type": "boolean", "default": false}}
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "host"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "url": {"type": "string", "pattern": "^(git@[A-Za-z0-9.-]+:[A-Za-z0-9._/-]+|https://[A-Za-z0-9.-]+/[A-Za-z0-9._/-]+)$"},
          "host": {"enum": ["github", "gitlab"]}
        }
      }
    },
    "overrides": {"type": "object"},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"path": {"type": "string"}}
    }
  }
}
