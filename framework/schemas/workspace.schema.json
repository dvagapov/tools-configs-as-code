{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "workspace", "frameworkRef", "repos"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "workspace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "frameworkRef": {"type": "string"},
    "wiki": {
      "type": "object",
      "required": ["repo", "branch"],
      "additionalProperties": false,
      "properties": {"repo": {"type": "string"}, "branch": {"type": "string"}}
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "host"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "url": {"type": "string"},
          "host": {"enum": ["github", "gitlab"]}
        }
      }
    },
    "overrides": {"type": "object"},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"path": {"type": "string"}}
    }
  }
}
